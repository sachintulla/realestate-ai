# =============================================================
# Ello AI Real Estate Voice Agent — Environment Variables
#
# Names only — NO real values. Copy the values you need into each
# app's local env file (e.g. apps/website/.env.local) and fill them
# in yourself. NEVER commit real secrets.
# Reference: docs/AI_BUILD_GUIDE.md §4.
# =============================================================

# --- Supabase (safe for client-side use) ---
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Server-only secrets (Edge Functions + server-only API routes) ---
# NEVER expose to the client, never log, never return in an API response.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# --- Website only: which business this public site submits leads for ---
# NOTE: NOT part of AI_BUILD_GUIDE.md §4. The guide never specifies how a
# public site maps to a business_id; the intake form needs one, so the
# website reads it from here. Revisit for multi-tenant/domain-based routing.
NEXT_PUBLIC_BUSINESS_ID=

# --- Deliberately NOT environment variables (listed here only as a reminder) ---
# Getello API key (per business): stored as a named secret in Supabase Vault,
#   referenced by businesses.getello_api_key_secret_name.
#   Never an env var, never a DB column, never hardcoded.
# GETELLO_AGENT_ID (per business): stored on the businesses.getello_agent_id
#   column — not an env var.
